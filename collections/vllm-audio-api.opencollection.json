{
  "opencollection": "1.0.0",
  "info": {
    "name": "vLLM OpenAI-Compatible Server Audio API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Audio",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Transcribe audio",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{host}:{port}/v1/audio/transcriptions",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "model",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Transcribe audio"
        },
        {
          "info": {
            "name": "Translate audio to English",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{host}:{port}/v1/audio/translations",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "model",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Translate audio to English"
        }
      ]
    }
  ],
  "bundled": true
}